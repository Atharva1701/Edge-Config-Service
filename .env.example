# Edge Config Service CLI — Environment Configuration
# Copy this file to .env and fill in the values

# Worker base URL (no trailing slash)
# For local dev: http://localhost:8787
# For production: https://edge-config-worker.<your-account>.workers.dev
EDGE_CONFIG_URL=http://localhost:8787

# API token — must match the API_TOKEN secret set in the Worker
EDGE_CONFIG_TOKEN=your-secret-api-token-here
