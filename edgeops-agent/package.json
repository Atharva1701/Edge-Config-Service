{
  "name": "edgeops-agent",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"wrangler dev --port 8787\" \"vite --config vite.config.ts --host 0.0.0.0\"",
    "dev:worker": "wrangler dev --port 8787",
    "dev:web": "vite --config vite.config.ts --host 0.0.0.0",
    "build:web": "vite build --config vite.config.ts",
    "build": "npm run build:web",
    "deploy": "npm run build && wrangler deploy",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@cloudflare/ai-chat": "latest",
    "agents": "latest",
    "ai": "latest",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "wrangler": "latest"
  }
}
